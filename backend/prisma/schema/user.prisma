// --- Auth & Users ---

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  password               String
  name                   String?
  role                   Role      @default(USER)
  signupSource           String    @default("EMAIL")
  lastActivityAt         DateTime?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  sessions                 Session[]
  progress                 Progress[]
  scores                   Score[]
  applications             Application[]
  gigs                     Gig[]
  savedTerms               SavedGlossaryTerm[]
  readingItems             ReadingProgress[]
  quizAttempts             QuizAttempt[]
  quizRetakeAccess         QuizRetakeUnlock[]     @relation("QuizRetakeLearner")
  quizRetakeUnlocksGranted QuizRetakeUnlock[]     @relation("QuizRetakeAdmin")
  assignmentSubmissions    AssignmentSubmission[]
  assignmentFeedbackGiven  AssignmentFeedback[]   @relation("AssignmentFeedbackReviewer")
  weekProgress             WeekProgress[]
  coursesCreated           Course[]               @relation("CourseCreator")
  courseApprovals          CourseApproval[]       @relation("CourseApprovalReviewer")
  courseEnrollments        CourseEnrollment[]
  moduleFeedbacks          ModuleFeedback[]
  profile                  UserProfile?
  facilitatorProfile       Facilitator?

  @@index([email])
  @@map("users")
}

enum Role {
  USER
  FACILITATOR
  ADMIN
  SUPER_ADMIN
}

// --- User Profile (onboarding data) ---

model UserProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  userRole            String?
  gender              String?
  country             String?
  experienceLevel     String?
  motivation          String?
  learningInterests   String[]  @default([])
  telegramHandle      String?
  twitterHandle       String?
  onboardingCompleted Boolean   @default(false)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum FacilitatorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model FacilitatorApplication {
  id          String                       @id @default(uuid())
  name        String
  email       String
  linkedinUrl String
  bio         String?
  whyJoin     String?
  status      FacilitatorApplicationStatus @default(PENDING)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@map("facilitator_applications")
}
